{
  "manifest_version": 3,
  "name": "TraderShield - Multi-Broker Discipline Guard",
  "version": "1.1.0",
  "description": "Enforces behavioral limiters on Zerodha Kite and mStock: blocks fund additions during market hours and prevents 0-DTE option trading.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "*://kite.zerodha.com/*",
    "*://*.mstock.com/*",
    "*://*.mstock.trade/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://kite.zerodha.com/*"],
      "js": ["utils/expiry_parser.js", "content_scripts/kite_interceptor.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.mstock.com/*", "*://*.mstock.trade/*"],
      "js": ["utils/expiry_parser.js", "content_scripts/mstock_interceptor.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_scripts/page_interceptor.js"],
      "matches": ["*://kite.zerodha.com/*", "*://*.mstock.com/*", "*://*.mstock.trade/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TraderShield - Multi-Broker Discipline Guard"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
